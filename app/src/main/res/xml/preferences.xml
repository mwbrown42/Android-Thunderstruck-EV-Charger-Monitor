<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/evcc_settings">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="evccEnableKey"
            app:title="@string/evcc_enable_title"
            app:summary="@string/evcc_enable_summary" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="evccAutoConnectKey"
            app:title="@string/evcc_autoconnect_title"
            app:summary="@string/evcc_autoconnect_summary"
            app:dependency="evccEnableKey" />

    </PreferenceCategory>

</PreferenceScreen>
